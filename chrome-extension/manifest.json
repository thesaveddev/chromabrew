{
  "manifest_version": 3,
  "name": "ChromaBrew Color Picker",
  "description": "Pick any color from your screen and open it in the ChromaBrew design system generator in one click.",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Pick a color · ChromaBrew",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
