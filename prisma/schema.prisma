generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["chromabrew"]
}

// â”€â”€â”€ Auth.js models â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  projectMemberships ProjectMember[]
  scans         Scan[]
  polarCustomer PolarCustomer?
  polarSubscriptions PolarSubscription[]
  entitlements  Entitlement[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@schema("chromabrew")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@schema("chromabrew")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@schema("chromabrew")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("chromabrew")
}

// â”€â”€â”€ Project models â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  visibility  ProjectVisibility @default(private)
  listedInGallery Boolean @default(false)
  config      Json
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions ProjectVersion[]
  members  ProjectMember[]
  votes    ProjectVote[]

  @@index([userId])
  @@index([visibility])
  @@schema("chromabrew")
}

enum ProjectVisibility {
  private
  public
  @@schema("chromabrew")
}

model ProjectVersion {
  id        String   @id @default(cuid())
  label     String?
  config    Json
  createdAt DateTime @default(now())

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@schema("chromabrew")
}

// --- Community gallery votes ---------------------------------------------
//
// One row per (project, voter): the second curation signal behind the
// gallery order. Voter identity is `user:<id>` for a signed-in reader and
// `ip:<hash>` for an anonymous one (same salted hash as the audit rate
// limiter), so voting needs no account while staying one-per-person. Only
// listed public projects can collect votes — the vote route 404s anything
// else, and unlisting a project simply stops its page rendering.
// Deleting a project removes its votes rather than orphaning them.
model ProjectVote {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  voterKey  String
  createdAt DateTime @default(now())

  @@unique([projectId, voterKey])
  @@index([projectId])
  @@schema("chromabrew")
}

// --- Team sharing --------------------------------------------------------
//
// Per-project collaborators, the thing behind the Pro "team sharing" line.
// The owner invites by email; the invitee needs a ChromaBrew account (OAuth
// or email) because access is granted to their user row, not to a token —
// no bearer links that leak the project to anyone holding them. `viewer`
// reads (including private projects); `editor` additionally saves config and
// manages versions. Ownership, deletion, visibility and membership itself
// stay owner-only. This is project-level collaboration, not a Phase 8 org:
// no workspaces, no roles beyond the project.

enum ProjectMemberRole {
  viewer
  editor
  @@schema("chromabrew")
}

model ProjectMember {
  id        String            @id @default(cuid())
  role      ProjectMemberRole @default(viewer)
  createdAt DateTime          @default(now())

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@schema("chromabrew")
}

// â”€â”€â”€ Feedback & Analytics â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Feedback {
  id        String   @id @default(cuid())
  type      FeedbackType @default(comment)
  message   String   @db.Text
  email     String?
  page      String?
  ip        String?  @db.Text
  userId    String?
  createdAt DateTime @default(now())
  @@schema("chromabrew")
}

enum FeedbackType {
  comment
  bug
  feature
  praise
  @@schema("chromabrew")
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  ip        String?  @db.Text
  userAgent String?  @db.Text
  referrer  String?  @db.Text
  country   String?
  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([createdAt])
  @@schema("chromabrew")
}

// --- Polar subscriptions (Phase 3 billing) -------------------------------
//
// The provider is Polar (docs/BILLING_SETUP.md). Three tables keep the two
// questions separate: `PolarCustomer` maps our user to Polar's customer,
// `PolarSubscription` is the billing record shown in the account UI, and
// `Entitlement` is the access snapshot every gate reads. Gates read the
// snapshot, never Polar's API — a webhook delay can only postpone access,
// and `expiresAt` bounds what a missed revocation could leak.

model PolarCustomer {
  id        String   @id @default(cuid())
  // Polar's customer id (c_…). The mapping to us is `userId`: checkout and
  // portal sessions are created with external_customer_id = user.id.
  polarId   String   @unique
  email     String?

  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@schema("chromabrew")
}

model PolarSubscription {
  id                 String   @id @default(cuid())
  polarId            String   @unique
  status             String
  productId          String
  interval           String
  amount             Int
  currency           String
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean  @default(false)
  endsAt             DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("chromabrew")
}

// One row per granted entitlement. NULL expiresAt is perpetual; a date
// means access lasted only until then (source: "polar" rows are written by
// webhook reconciliation and can never outlive their subscription clock).
model Entitlement {
  id        String    @id @default(cuid())
  key       String
  source    String    @default("polar")
  expiresAt DateTime?
  grantedAt DateTime  @default(now())

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([key])
  @@schema("chromabrew")
}

// --- Audit / Website scanning ---

enum ScanStatus {
  queued
  running
  completed
  partially_completed
  failed
  cancelled
  @@schema("chromabrew")
}

enum ScanScope {
  single_page
  homepage_plus_pages
  selected_pages
  @@schema("chromabrew")
}

enum FindingSeverity {
  critical
  high
  medium
  low
  informational
  @@schema("chromabrew")
}

enum FindingCategory {
  color_contrast
  accessibility
  visual_design
  design_system
  technical
  metadata
  @@schema("chromabrew")
}

enum DetectionMethod {
  deterministic
  ai_assisted
  hybrid
  @@schema("chromabrew")
}

enum PreviewMethod {
  annotated_original
  illustrative_proposal
  rendered_change
  @@schema("chromabrew")
}
model Scan {
  id                String        @id @default(cuid())
  url               String        @db.Text
  normalizedUrl     String        @db.Text
  status            ScanStatus    @default(queued)
  scope             ScanScope     @default(single_page)
  viewportWidth     Int           @default(1280)
  viewportHeight    Int           @default(720)
  pagesScanned      Int           @default(0)
  pagesTotal        Int           @default(0)
  pagesFailed       Int           @default(0)
  errorMessage      String?       @db.Text
  startedAt         DateTime?
  completedAt       DateTime?
  durationMs        Int?
  userAgent         String?       @db.Text
  ipHash            String?       @db.Text
  rulesVersion      String        @default("1.0.0")
  scannerVersion    String        @default("1.0.0")
  aiModel           String?
  metadata          Json?
  // Shareable report link (see src/lib/audit/share.ts). NULL means not shared:
  // a report is never public because someone knows or guesses its id.
  shareToken        String?       @unique @db.Text
  sharedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  userId            String?
  user              User?         @relation(fields: [userId], references: [id])
  scannedPages      ScannedPage[]
  findings          Finding[]
  previews          Preview[]
  reports           Report[]
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@schema("chromabrew")
}
model ScannedPage {
  id                String        @id @default(cuid())
  url               String        @db.Text
  title             String?       @db.Text
  statusCode        Int?
  loadTimeMs        Int?
  rendered          Boolean       @default(false)
  screenshotPath    String?       @db.Text
  screenshotUrl     String?       @db.Text
  screenshotData    Bytes?
  domHash           String?
  metadata          Json?
  errorMessage      String?       @db.Text
  createdAt         DateTime      @default(now())
  scanId            String
  scan              Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  findings          Finding[]
  @@index([scanId])
  @@schema("chromabrew")
}
model Finding {
  id                String              @id @default(cuid())
  ruleId            String
  category          FindingCategory
  severity          FindingSeverity
  title             String              @db.Text
  description       String              @db.Text
  explanation       String?             @db.Text
  whyMatters        String?             @db.Text
  recommendation    String?             @db.Text
  implementation    String?             @db.Text
  cssSuggestion     String?             @db.Text
  tokenSuggestion   Json?
  evidence          Json?
  elementSelector   String?             @db.Text
  xpath             String?             @db.Text
  originalValues    Json?
  suggestedValues   Json?
  wcagCriterion     String?
  detectionMethod   DetectionMethod     @default(deterministic)
  confidence        Decimal?            @db.Decimal(3,2)
  verificationStatus String             @default("unverified")
  isDuplicate       Boolean             @default(false)
  duplicateGroupId  String?
  resolved          Boolean             @default(false)
  resolvedAt        DateTime?
  ignored           Boolean             @default(false)
  ignoredAt         DateTime?
  userFeedback      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  scanId            String
  scan              Scan                @relation(fields: [scanId], references: [id], onDelete: Cascade)
  pageId            String?
  page              ScannedPage?        @relation(fields: [pageId], references: [id])
  proposedFix       ProposedFix?
  previews          Preview[]
  @@index([scanId])
  @@index([category, severity])
  @@index([ruleId])
  @@schema("chromabrew")
}
model ProposedFix {
  id                String        @id @default(cuid())
  title             String        @db.Text
  description       String?       @db.Text
  originalValues    Json?
  proposedValues    Json?
  cssChanges        String?       @db.Text
  tokenChanges      Json?
  contrastBefore    Decimal?      @db.Decimal(4,2)
  contrastAfter     Decimal?      @db.Decimal(4,2)
  passesWcag        Boolean?
  validated         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  findingId         String        @unique
  finding           Finding       @relation(fields: [findingId], references: [id], onDelete: Cascade)
  @@schema("chromabrew")
}

model Preview {
  id                String          @id @default(cuid())
  method            PreviewMethod
  imagePath         String?         @db.Text
  imageUrl          String?         @db.Text
  htmlContent       String?         @db.Text
  cssContent        String?         @db.Text
  viewportWidth     Int?
  viewportHeight    Int?
  description       String?         @db.Text
  isVerified        Boolean         @default(false)
  createdAt         DateTime        @default(now())
  scanId            String
  scan              Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)
  findingId         String?
  finding           Finding?        @relation(fields: [findingId], references: [id])
  @@index([scanId])
  @@schema("chromabrew")
}

model Report {
  id                String        @id @default(cuid())
  format            String        @default("pdf")
  filePath          String?       @db.Text
  fileUrl           String?       @db.Text
  generatedAt       DateTime      @default(now())
  expiresAt         DateTime?
  downloadCount     Int           @default(0)
  scanId            String
  scan              Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  @@index([scanId])
  @@schema("chromabrew")
}

// Liveness of the audit worker (see src/lib/audit/heartbeat.ts). The worker and
// the web tier share no filesystem and no network path, so the database is the
// only place the web tier can ask whether anything is there to claim a scan.
// One row per worker process; `workerId` is its identity, so a restart rewrites
// its own row rather than adding one. A row is a beat, not a record of work: a
// worker that stops cleanly marks itself `stoppedAt` and one that is killed
// simply goes stale. Either way the answer is the same to a reader, but the mark
// arrives at once instead of after the stale window, and the row is kept so that
// "stopped" stays distinguishable from "never ran".
model WorkerHeartbeat {
  workerId          String        @id @db.Text
  lastSeenAt        DateTime
  startedAt         DateTime
  // Set on a clean shutdown, cleared by the next beat from this id.
  stoppedAt         DateTime?
  version           String?
  host              String?
  @@index([lastSeenAt])
  @@schema("chromabrew")
}

// Scheduled whole-site re-scans (see src/lib/audit/schedules.ts). One row per
// watched site per user: the worker enqueues a fresh scan whenever nextRunAt
// passes, then advances it by intervalDays. userId is a plain string, not a
// relation — it is only ever filtered on, never joined.
model AuditSchedule {
  id                String        @id @default(cuid())
  userId            String
  url               String        @db.Text
  normalizedUrl     String        @db.Text
  scope             ScanScope     @default(homepage_plus_pages)
  viewportId        String        @default("desktop")
  intervalDays      Int           @default(7)
  active            Boolean       @default(true)
  nextRunAt         DateTime
  lastRunAt         DateTime?
  lastScanId        String?
  failureCount      Int           @default(0)
  // Emailed scheduled reports (Pro): JSON array of up to 3 recipient emails.
  // Empty array means no email — the watch still re-scans, and the timeline
  // still compares. Stored as text so the hand-managed production database
  // needs no special type for it.
  emailRecipients   String        @default("[]") @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([active, nextRunAt])
  @@index([userId])
  @@schema("chromabrew")
}
