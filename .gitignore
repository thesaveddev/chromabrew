# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results
/playwright-report

# marketing assets (never deployed)
/marketing
# scripts/ is tracked by default. The build runs scripts/db-migrate.mjs, the
# audit worker is a production component the VPS checks out
# (docs/AUDIT_WORKER_HOST.md), and a fresh clone has to contain both. Only the
# one-off asset generators below stay out.
#
# The exceptions are listed rather than the inclusions on purpose: a whitelist
# silently drops anything new, which is how `scripts/audit-worker.mjs` went
# missing from the repository while its runbook told you to run it.
/scripts/generate-blog-heroes.mjs
/scripts/render-flow-gif.mjs


/src/generated/prisma

# audit scanner screenshots (runtime artifacts)
/.audit-screenshots
