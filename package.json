{
  "name": "colors",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/db-migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "audit:worker": "node --import tsx scripts/audit-worker.mjs",
    "seo:audit": "node --import tsx scripts/seo-audit.mjs",
    "build:figma": "node figma-plugin/build.mjs",
    "typecheck:figma": "tsc -p figma-plugin/tsconfig.json --noEmit",
    "billing:setup": "node scripts/polar-setup.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@polar-sh/nextjs": "^1.0.0",
    "@polar-sh/sdk": "^1.0.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vercel/analytics": "^2.0.1",
    "axe-core": "^4.13.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.24.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
